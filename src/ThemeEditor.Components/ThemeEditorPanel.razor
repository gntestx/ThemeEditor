<MudPaper Class="theme-editor pa-5" Elevation="1">
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <div>
                <MudText Typo="Typo.h5">Theme editor</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Changes are applied to the active MudTheme immediately.
                </MudText>
            </div>
            <MudSwitch T="bool"
                       Value="IsDarkMode"
                       ValueChanged="ToggleDarkMode"
                       Color="Color.Primary"
                       Label="Dark mode" />
        </MudStack>

        <MudDivider />

        <details open>
            <summary>Light palette</summary>
            <div class="color-grid section-content">
                <ThemeColorInput Label="Primary" Value="Theme.PaletteLight.Primary" ValueChanged="value => UpdatePalette(false, "primary", value)" />
                <ThemeColorInput Label="Secondary" Value="Theme.PaletteLight.Secondary" ValueChanged="value => UpdatePalette(false, "secondary", value)" />
                <ThemeColorInput Label="Background" Value="Theme.PaletteLight.Background" ValueChanged="value => UpdatePalette(false, "background", value)" />
                <ThemeColorInput Label="Surface" Value="Theme.PaletteLight.Surface" ValueChanged="value => UpdatePalette(false, "surface", value)" />
                <ThemeColorInput Label="App bar" Value="Theme.PaletteLight.AppbarBackground" ValueChanged="value => UpdatePalette(false, "appbar", value)" />
                <ThemeColorInput Label="Primary text" Value="Theme.PaletteLight.TextPrimary" ValueChanged="value => UpdatePalette(false, "text-primary", value)" />
                <ThemeColorInput Label="Secondary text" Value="Theme.PaletteLight.TextSecondary" ValueChanged="value => UpdatePalette(false, "text-secondary", value)" />
                <ThemeColorInput Label="Divider" Value="Theme.PaletteLight.Divider" ValueChanged="value => UpdatePalette(false, "divider", value)" />
                <ThemeColorInput Label="Info" Value="Theme.PaletteLight.Info" ValueChanged="value => UpdatePalette(false, "info", value)" />
                <ThemeColorInput Label="Success" Value="Theme.PaletteLight.Success" ValueChanged="value => UpdatePalette(false, "success", value)" />
                <ThemeColorInput Label="Warning" Value="Theme.PaletteLight.Warning" ValueChanged="value => UpdatePalette(false, "warning", value)" />
                <ThemeColorInput Label="Error" Value="Theme.PaletteLight.Error" ValueChanged="value => UpdatePalette(false, "error", value)" />
            </div>
        </details>

        <details>
            <summary>Dark palette</summary>
            <div class="color-grid section-content">
                <ThemeColorInput Label="Primary" Value="Theme.PaletteDark.Primary" ValueChanged="value => UpdatePalette(true, "primary", value)" />
                <ThemeColorInput Label="Secondary" Value="Theme.PaletteDark.Secondary" ValueChanged="value => UpdatePalette(true, "secondary", value)" />
                <ThemeColorInput Label="Background" Value="Theme.PaletteDark.Background" ValueChanged="value => UpdatePalette(true, "background", value)" />
                <ThemeColorInput Label="Surface" Value="Theme.PaletteDark.Surface" ValueChanged="value => UpdatePalette(true, "surface", value)" />
                <ThemeColorInput Label="App bar" Value="Theme.PaletteDark.AppbarBackground" ValueChanged="value => UpdatePalette(true, "appbar", value)" />
                <ThemeColorInput Label="Primary text" Value="Theme.PaletteDark.TextPrimary" ValueChanged="value => UpdatePalette(true, "text-primary", value)" />
                <ThemeColorInput Label="Secondary text" Value="Theme.PaletteDark.TextSecondary" ValueChanged="value => UpdatePalette(true, "text-secondary", value)" />
                <ThemeColorInput Label="Divider" Value="Theme.PaletteDark.Divider" ValueChanged="value => UpdatePalette(true, "divider", value)" />
                <ThemeColorInput Label="Info" Value="Theme.PaletteDark.Info" ValueChanged="value => UpdatePalette(true, "info", value)" />
                <ThemeColorInput Label="Success" Value="Theme.PaletteDark.Success" ValueChanged="value => UpdatePalette(true, "success", value)" />
                <ThemeColorInput Label="Warning" Value="Theme.PaletteDark.Warning" ValueChanged="value => UpdatePalette(true, "warning", value)" />
                <ThemeColorInput Label="Error" Value="Theme.PaletteDark.Error" ValueChanged="value => UpdatePalette(true, "error", value)" />
            </div>
        </details>

        <details open>
            <summary>Typography</summary>
            <MudStack Spacing="2" Class="section-content">
                <MudTextField T="string"
                              Label="Font family"
                              Value="@FontFamily"
                              ValueChanged="UpdateFontFamily"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              HelperText="Comma-separated CSS font families" />

                <TypographyStyleInput Label="H1" Style="Theme.Typography.H1" Changed="NotifyThemeChanged" />
                <TypographyStyleInput Label="H2" Style="Theme.Typography.H2" Changed="NotifyThemeChanged" />
                <TypographyStyleInput Label="H3" Style="Theme.Typography.H3" Changed="NotifyThemeChanged" />
                <TypographyStyleInput Label="H4" Style="Theme.Typography.H4" Changed="NotifyThemeChanged" />
                <TypographyStyleInput Label="H5" Style="Theme.Typography.H5" Changed="NotifyThemeChanged" />
                <TypographyStyleInput Label="H6" Style="Theme.Typography.H6" Changed="NotifyThemeChanged" />
                <TypographyStyleInput Label="Subtitle 1" Style="Theme.Typography.Subtitle1" Changed="NotifyThemeChanged" />
                <TypographyStyleInput Label="Subtitle 2" Style="Theme.Typography.Subtitle2" Changed="NotifyThemeChanged" />
                <TypographyStyleInput Label="Body 1" Style="Theme.Typography.Body1" Changed="NotifyThemeChanged" />
                <TypographyStyleInput Label="Body 2" Style="Theme.Typography.Body2" Changed="NotifyThemeChanged" />
                <TypographyStyleInput Label="Button" Style="Theme.Typography.Button" Changed="NotifyThemeChanged" />
                <TypographyStyleInput Label="Caption" Style="Theme.Typography.Caption" Changed="NotifyThemeChanged" />
                <TypographyStyleInput Label="Overline" Style="Theme.Typography.Overline" Changed="NotifyThemeChanged" />
            </MudStack>
        </details>

        <details open>
            <summary>Shape</summary>
            <div class="section-content">
                <MudText Typo="Typo.body2">Default border radius: @BorderRadius px</MudText>
                <MudSlider T="int"
                           Min="0"
                           Max="32"
                           Step="1"
                           Value="BorderRadius"
                           ValueChanged="UpdateRadius"
                           Color="Color.Primary" />
            </div>
        </details>

        <MudStack Row="true" Justify="Justify.FlexEnd">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="Reset">
                Reset to MudBlazor defaults
            </MudButton>
        </MudStack>
    </MudStack>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public MudTheme Theme { get; set; } = new();

    [Parameter]
    public bool IsDarkMode { get; set; }

    [Parameter]
    public EventCallback<MudTheme> ThemeChanged { get; set; }

    [Parameter]
    public EventCallback<bool> IsDarkModeChanged { get; set; }

    [Parameter]
    public EventCallback ResetRequested { get; set; }

    private string FontFamily =>
        string.Join(", ", Theme.Typography.Default.FontFamily ?? Array.Empty<string>());

    private int BorderRadius =>
        int.TryParse(Theme.LayoutProperties.DefaultBorderRadius.Replace("px", string.Empty), out var value)
            ? value
            : 4;

    private Task ToggleDarkMode(bool value) => IsDarkModeChanged.InvokeAsync(value);

    private async Task UpdatePalette(bool dark, string property, MudColor? value)
    {
        if (value is null)
            return;

        var palette = dark ? Theme.PaletteDark : Theme.PaletteLight;

        switch (property)
        {
            case "primary": palette.Primary = value; break;
            case "secondary": palette.Secondary = value; break;
            case "background": palette.Background = value; break;
            case "surface": palette.Surface = value; break;
            case "appbar": palette.AppbarBackground = value; break;
            case "text-primary": palette.TextPrimary = value; break;
            case "text-secondary": palette.TextSecondary = value; break;
            case "divider": palette.Divider = value; break;
            case "info": palette.Info = value; break;
            case "success": palette.Success = value; break;
            case "warning": palette.Warning = value; break;
            case "error": palette.Error = value; break;
        }

        await NotifyThemeChanged();
    }

    private async Task UpdateFontFamily(string? value)
    {
        var fontFamilies = (value ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        Theme.Typography.Default.FontFamily = fontFamilies.Length == 0
            ? new MudTheme().Typography.Default.FontFamily
            : fontFamilies;

        await NotifyThemeChanged();
    }

    private async Task UpdateRadius(int value)
    {
        Theme.LayoutProperties.DefaultBorderRadius = $"{value}px";
        await NotifyThemeChanged();
    }

    private Task NotifyThemeChanged() => ThemeChanged.InvokeAsync(Theme);

    private Task Reset() => ResetRequested.InvokeAsync();
}
